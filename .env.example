# SQL Server (read-only login)
SQL_SERVER=SYNCSERVER\SYNCDB
SQL_DATABASE=SyncJournal
SQL_USER=concourse_readonly
SQL_PASSWORD=

# History: first fiscal year to include in bulk pull (dashboard uses 2023+)
START_DATE=2023-01-01

# Local paths (defaults assume repo root)
DATA_DIR=data
OUTPUT_DIR=public/data
LOG_DIR=logs

# 7shifts REST API (labor.json, labor_intraday.json, _employees_labor.json)
SEVENSHIFTS_TOKEN=
SEVENSHIFTS_COMPANY_ID=
SEVENSHIFTS_TIMEZONE=America/Los_Angeles

# Entire published labor history, NOT a nightly increment. labor.json is rewritten
# in full every run and never merged, so lowering this deletes history from the
# live dashboard. run_nightly.ps1 refuses to publish a labor.json with fewer than 300 days.
SEVENSHIFTS_PULL_DAYS=365

# Optional: resolved from /companies when blank
SEVENSHIFTS_GUID=

# Optional: employer tax/benefit uplift, only used by the punch-based fallback
# estimate. Irrelevant while the Daily Sales & Labor report is available.
# SEVENSHIFTS_LABOR_UPLIFT_PCT=0

# Optional: ODBC driver name (auto-detected if unset)
# ODBC_DRIVER=ODBC Driver 18 for SQL Server
