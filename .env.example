# SQL Server (read-only login)
SQL_SERVER=SYNCSERVER\SYNCDB
SQL_DATABASE=SyncJournal
SQL_USER=concourse_readonly
SQL_PASSWORD=

# History: first fiscal year to include in bulk pull (dashboard uses 2023+)
START_DATE=2023-01-01

# Local paths (defaults assume repo root)
DATA_DIR=data
OUTPUT_DIR=public/data
LOG_DIR=logs

# 7shifts REST API (labor.json, labor_intraday.json, _employees_labor.json)
SEVENSHIFTS_TOKEN=
SEVENSHIFTS_COMPANY_ID=
SEVENSHIFTS_TIMEZONE=America/Los_Angeles

# Entire published labor history, NOT a nightly increment. labor.json is rewritten
# in full every run and never merged, so lowering this deletes history from the
# live dashboard. run_nightly.ps1 refuses to publish a labor.json with fewer than 300 days.
SEVENSHIFTS_PULL_DAYS=365

# Optional: resolved from /companies when blank
SEVENSHIFTS_GUID=

# Optional: employer tax/benefit uplift, only used by the punch-based fallback
# estimate. Irrelevant while the Daily Sales & Labor report is available.
# SEVENSHIFTS_LABOR_UPLIFT_PCT=0

# Optional: ODBC driver name (auto-detected if unset)
# ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Lane chart on the leads site. The 10-minute task and the 05:30 nightly both
# POST the POS reservation book here. LEADS_LANE_SYNC_SECRET must match the
# Netlify env var LANE_SYNC_SECRET on concourseleads.
LEADS_LANE_SYNC_URL=https://concourseleads.netlify.app/api/pos-lanes/sync
LEADS_LANE_SYNC_SECRET=

# Daily review email (scripts/daily_review.py). Gmail app password for
# GMAIL_USER, not the account password. Create it only after 2-Step
# Verification is on. DAILY_REVIEW_TO is a comma-separated recipient list.
# Set DAILY_REVIEW_ENABLED=0 to stop sending without a code change.
GMAIL_USER=concoursebowling@gmail.com
GMAIL_APP_PASSWORD=
DAILY_REVIEW_TO=
DAILY_REVIEW_ENABLED=0

# Week, month, quarter, and year reviews (scripts/period_review.py). Same Gmail
# account as the daily review. PERIOD_REVIEW_TO falls back to DAILY_REVIEW_TO.
# Leave PERIOD_REVIEW_ENABLED=0 until a preview looks right. A --to send does
# not mark the period as sent, so the real one still goes out.
# DASHBOARD_URL is optional. When set, the period email links to it.
PERIOD_REVIEW_TO=
PERIOD_REVIEW_ENABLED=0
# DASHBOARD_URL=
